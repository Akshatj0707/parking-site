# HOW TO USE THIS FILE
# 1. Make a copy of it in the same folder and name the copy  .env   (a dot, then "env", nothing else).
# 2. Open .env in any text editor and fill in what you need.
# 3. Stop the site (Ctrl+C) and start it again so it reads your changes.
# Lines that start with # are notes. Never share your .env file or put it on GitHub: it holds your secrets.

# ------------------------------------------------------------------------------------
# RAZORPAY (payments)
# Leave these two empty to run in DEMO MODE: everything works, but payment is only simulated.
# To try the real Razorpay checkout without real money:
#   Razorpay Dashboard -> switch the toggle at the top to "Test Mode" -> Account & Settings -> API Keys
#   -> Generate Key. Paste the Key Id and Key Secret below.
# Test keys start with rzp_test_ and move no money. Live keys start with rzp_live_ and move real money.
# ------------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional on your own computer, strongly recommended once the site is online. See the README section "Webhook".
RAZORPAY_WEBHOOK_SECRET=

# For a public DEMO only (the free Render demo, render-free.yaml, sets it). In production, with no Razorpay keys above, the
# site normally switches booking off. With this set to on it simulates the payment instead, so the whole site works at once.
# Once both Razorpay keys are set the real Razorpay checkout is used and this does nothing. Never use it for real customers.
# DEMO_PAYMENTS=on

# ------------------------------------------------------------------------------------
# OPERATOR DASHBOARD  (http://localhost:3000/dashboard)
# Choose a long password. While it is empty, anyone who can open the site can open the dashboard.
# In production the dashboard stays switched off until you set it.
# ------------------------------------------------------------------------------------
OPERATOR_USER=operator
OPERATOR_PASSWORD=

# ------------------------------------------------------------------------------------
# YOUR SITE
# ------------------------------------------------------------------------------------
SITE_NAME=Bayfind
# Shown in the footer and in messages that say "contact us". Leave empty to say "ask at the parking office".
SUPPORT_EMAIL=

# The Contact, Terms and Privacy pages (open /contact on the site) show these. Razorpay checks that a shop has such pages
# before it allows real payments, and wants a phone number and an address on the Contact page. Fill them in before you go
# live. Leave them empty while you are only testing.
# BUSINESS_NAME is the name of your business as it is on your Razorpay account (default: SITE_NAME above).
# Keep the address on one line.
BUSINESS_NAME=
SUPPORT_PHONE=
BUSINESS_ADDRESS=

# ------------------------------------------------------------------------------------
# CHAT ASSISTANT (the yellow "Ask us" button on the public pages)
# It works as soon as the site runs: it answers from your own settings with built-in rules. No setup, no cost.
# To let an AI (Anthropic's Claude) write the answers instead, paste an Anthropic API key below. The steps, the costs and
# the privacy side are in the README, section 3, "The chat assistant". The short version:
#   platform.claude.com -> Billing (add credit) -> API keys -> Create key. The key starts with sk-ant-.
# If the AI cannot answer, drivers get the built-in answers instead. Keep this key as private as the Razorpay Key Secret.
# With a key set, what a driver types in the chat is sent to Anthropic. The Privacy page of the site says so by itself.
# ------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# A FREE way to get AI answers (also for general questions): a key from Google Gemini (aistudio.google.com) or Groq
# (console.groq.com). AI_PROVIDER is gemini (default), groq or custom (then AI_BASE_URL and AI_MODEL are needed too).
# The Anthropic key above is used first when both are set.
AI_API_KEY=
AI_PROVIDER=gemini
# AI_MODEL=
# AI_BASE_URL=

# Accounts. Customers sign in before booking; set to off to let anyone book without an account.
# CUSTOMER_LOGIN_REQUIRED=on
# SESSION_SECRET=
# SEED_TEST_CUSTOMER=off

# The most AI answers the whole site gives in one day. Past it, drivers get the built-in answers until the next day.
# 0 turns the AI off even though a key is set.
# CHAT_DAILY_LIMIT=500

# The AI model that writes the answers. The default is Anthropic's small, fast and cheap one. A wrong name makes the AI fail.
# CHAT_MODEL=claude-haiku-5-5

# Write off to hide the chat window on every page.
# CHAT_ENABLED=off

# ------------------------------------------------------------------------------------
# PRICES, in rupees PER HOUR
# ------------------------------------------------------------------------------------
RATE_CAR_WEEKDAY=40
RATE_CAR_WEEKEND=60
RATE_BIKE_WEEKDAY=20
RATE_BIKE_WEEKEND=30

# Weekend days as numbers: 0 = Sunday, 1 = Monday ... 6 = Saturday. Default is Saturday and Sunday.
# The price depends on the day a booking STARTS.
WEEKEND_DAYS=0,6

# Minutes a bay is held while the customer pays.
HOLD_MINUTES=10

# Minutes ahead of UTC for the lot's clock. 330 = India (UTC+05:30). All dates and times use this clock.
UTC_OFFSET_MINUTES=330

# ------------------------------------------------------------------------------------
# SERVER
# ------------------------------------------------------------------------------------
PORT=3000
# Where bookings are saved. Default is the "data" folder next to server.js. Back this folder up.
# On Render (render.com) leave it empty: the site then saves to the Render disk, in /var/data/test while Razorpay test
# keys are in use and in /var/data/live once live keys are (see DEPLOY-RENDER.md).
# The free demo (render-free.yaml) has no disk, so it sets this to a temporary folder: its bookings do not last.
# DATA_DIR=

# Set to "production" on the live server. Then booking is disabled unless Razorpay keys are present,
# the dashboard needs OPERATOR_PASSWORD, and the site listens to the outside world instead of only this computer.
# NODE_ENV=production

# Behind a hosting platform or reverse proxy that adds X-Forwarded-For? Set the number of proxies (usually 1).
# On Render it is 1 unless you set another number. The dashboard's "Setup check" shows whether the number is right.
# TRUST_PROXY=1

# Only if the Razorpay popup is blocked by the browser's security rules (check the browser console): DISABLE_CSP=1
# DISABLE_CSP=
